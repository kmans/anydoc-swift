+        || axes.iter().any(|axis| {
+            axis.first_descendant(ns::CHART, "logBase").is_some()
+                || axis.find(ns::CHART, "dispUnits").is_some()
+        })
+    {
+        result.incompatible_axes = true;
+    }
+    result.axis_titles = axes
+        .iter()
+        .map(|axis| {
+            axis.find(ns::CHART, "title")
+                .map(|e| {
+                    e.descendants(ns::A, "t")
+                        .map(Element::text)
+                        .collect::<Vec<_>>()
+                        .join(" ")
+                })
+                .unwrap_or_default()
+        })
+        .collect();
