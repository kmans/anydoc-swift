+                false,
+                cells,
+                &location,
+                diagnostics,
+                budget,
+                date1904,
+            )?;
+            let (vals, val_refs) = values(
+                series
+                    .find(ns::CHART, "val")
+                    .or_else(|| series.find(ns::CHART, "yVal")),
+                true,
+                cells,
+                &location,
+                diagnostics,
+                budget,
+                date1904,
+            )?;
+            refs.extend(val_refs);
+            let mut additional_values = std::collections::BTreeMap::new();
