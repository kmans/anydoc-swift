+fn explicit_header_row(
+    pkg: &mut Package,
+    worksheet: &Element,
+    part: &str,
+) -> Result<Option<u32>, ConvertError> {
+    let rels = read_rels(pkg, &rels_part_for(part))?;
+    for reference in worksheet.descendants(ns::SML, "tablePart") {
+        let Some(target) = reference
+            .attr_qualified(ns::R, "id")
+            .and_then(|id| rels.internal_target(id))
+        else {
+            continue;
+        };
+        let Ok(target) = path::resolve(part, target) else {
+            continue;
+        };
+        let Some(root) = pkg.optional_xml_part(&target.path)? else {
+            continue;
+        };
+        if let Some(table) = root.find(ns::SML, "table") {
+            if table.attr_unqualified("headerRowCount") == Some("0") {
+                continue;
+            }
+            if let Some(at) = table
+                .attr_unqualified("ref")
+                .and_then(|r| r.split(':').next())
+                .and_then(super::charts::coordinate)
+            {
+                return Ok(Some(at.0));
+            }
+        }
+    }
+    Ok(None)
+}
